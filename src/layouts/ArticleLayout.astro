---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import Breadcrumbs from '~/components/seo/Breadcrumbs.astro';
import ArticleHeader from '~/components/blog/ArticleHeader.astro';
import TableOfContents from '~/components/blog/TableOfContents.astro';
import KeyTakeaways from '~/components/content/KeyTakeaways.astro';
import SourcesList from '~/components/blog/SourcesList.astro';
import ArticleFeedback from '~/components/blog/ArticleFeedback.astro';
import RelatedArticles from '~/components/blog/RelatedArticles.astro';
import ProductCta from '~/components/content/ProductCta.astro';
import { primaryNav, footerNav } from '~/lib/nav';
import { localeBase, type Locale } from '~/config/locales';
import { categoryHref, categoryLabel } from '~/config/taxonomy';
import { getDictionary } from '~/i18n';
import { blogIndexHref, type Article } from '~/lib/blog';
import type { Crumb } from '~/lib/crumbs';
import { coverOgImage } from '~/lib/ogImage';
import { articleSchema } from '~/lib/schema';
import type { Alternate } from '~/lib/translations';
import '~/styles/blog.css';
import '~/styles/article.css';
import '~/styles/blocks.css';

/** Below this many sections a contents list is longer than the outline it describes. */
const MIN_TOC_SECTIONS = 4;

interface Props {
  article: Article;
  author: CollectionEntry<'authors'>;
  locale: Locale;
  alternates: Alternate[];
  headings: MarkdownHeading[];
  related: Article[];
}

const { article, author, locale, alternates, headings, related } = Astro.props;
const dict = getDictionary(locale);
const base = localeBase(locale);
const { data } = article.entry;

const showToc = headings.filter((heading) => heading.depth === 2).length >= MIN_TOC_SECTIONS;

const crumbs: Crumb[] = [
  { label: dict.blog.home, href: base },
  { label: dict.blog.heading, href: blogIndexHref(locale) },
  { label: categoryLabel(article.category, locale), href: categoryHref(article.category, locale) },
  { label: data.title },
];

const title = data.seoTitle ?? data.title;

/**
 * The social card and the structured data are both built here, from the same
 * cover and the same crumbs the page renders, so a shared link and a crawler
 * describe the article the way the page does.
 */
const ogImage = await coverOgImage(data.coverImage, data.coverImageAlt);
const jsonLd = articleSchema({ article, author, image: ogImage, crumbs, title });
---

<BaseLayout
  locale={locale}
  path={article.path}
  alternates={alternates}
  title={title}
  description={data.description}
  ogType="article"
  ogImage={ogImage}
  publishedTime={article.publishedAt.toISOString()}
  modifiedTime={(article.updatedAt ?? article.publishedAt).toISOString()}
  jsonLd={jsonLd}
>
  <a class="skip-link" href="#main">{dict.nav.skipToContent}</a>

  <Header
    homeHref={base}
    navItems={primaryNav(dict, base)}
    locale={locale}
    alternates={alternates}
    dict={dict}
  />

  <main id="main">
    <div class={showToc ? 'article-shell article-shell-toc' : 'article-shell'}>
      <div class="article-main">
        <Breadcrumbs crumbs={crumbs} label={dict.blog.breadcrumbLabel} />

        <ArticleHeader article={article} author={author} locale={locale} dict={dict} />

        {/* The summary comes before the contents list: what the article concludes
            is more use to someone deciding whether to read it than where the
            sections are. */}
        <KeyTakeaways items={data.takeaways} />

        {showToc && <TableOfContents headings={headings} label={dict.blog.tocLabel} variant="inline" />}

        <article class="article-body">
          <slot />
        </article>

        {/* Everything after the argument itself. `data-article-end` doubles as
            the marker that says a reader got this far — see `lib/track.ts`. */}
        <footer class="article-footer" data-article-end>
          <SourcesList
            sources={data.sources}
            heading={dict.blog.sourcesLabel}
            accessedLabel={dict.blog.accessedLabel}
            locale={locale}
          />

          <ArticleFeedback dict={dict} />

          {data.showProductCta && <ProductCta />}

          <RelatedArticles articles={related} locale={locale} dict={dict} />
        </footer>
      </div>

      {
        showToc && (
          <div class="article-aside">
            <TableOfContents headings={headings} label={dict.blog.tocLabel} variant="aside" />
          </div>
        )
      }
    </div>
  </main>

  <Footer links={footerNav(dict, base)} fineprint={dict.footer.fineprint} />
</BaseLayout>
