---
import BaseHead, { type Props as SeoProps } from '~/components/seo/BaseHead.astro';
import Analytics from '~/components/analytics/Analytics.astro';
import PlatformDetect from '~/components/layout/PlatformDetect.astro';
import { localeMeta } from '~/config/locales';
import '~/styles/tokens.css';
import '~/styles/base.css';
import '~/styles/layout.css';
import '~/styles/components.css';
import '~/styles/responsive.css';

interface Props extends SeoProps {
  /** Root-relative images to preload for LCP. */
  preloadImages?: string[];
}

const { preloadImages = [], ...seo } = Astro.props;
const meta = localeMeta[seo.locale];
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#7205ff" />
    <meta name="apple-itunes-app" content="app-id=6756809306" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <BaseHead {...seo} />

    <PlatformDetect />

    {preloadImages.map((href) => <link rel="preload" href={href} as="image" />)}

    <!-- Fonts (Tipza: Space Grotesk + Figtree) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
  </head>

  <body>
    <slot />
    <Analytics />
  </body>
</html>
