---
import BaseLayout from './BaseLayout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import { primaryNav, footerNav } from '~/lib/nav';
import { localeBase, type Locale } from '~/config/locales';
import { getDictionary } from '~/i18n';
import type { Alternate } from '~/lib/translations';
import type { OgImage } from '~/lib/ogImage';
import type { Node } from '~/lib/schema';

interface Props {
  locale: Locale;
  /** Locale-relative path, used for the canonical URL. */
  path: string;
  alternates: Alternate[];
  title: string;
  description?: string;
  ogDescription?: string;
  ogImage?: OgImage;
  noindex?: boolean;
  preloadImages?: string[];
  jsonLd?: Node;
}

const { locale, ...seo } = Astro.props;
const dict = getDictionary(locale);
const base = localeBase(locale);
---

<BaseLayout locale={locale} {...seo}>
  <slot name="head" slot="head" />

  <a class="skip-link" href="#main">{dict.nav.skipToContent}</a>

  <Header
    homeHref={base}
    navItems={primaryNav(dict, base)}
    locale={locale}
    alternates={seo.alternates}
    dict={dict}
  />

  <main id="main">
    <slot />
  </main>

  <Footer links={footerNav(dict, base)} fineprint={dict.footer.fineprint} />
</BaseLayout>
