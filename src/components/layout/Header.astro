---
import StoreButtons from './StoreButtons.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { Locale } from '~/config/locales';
import type { Alternate } from '~/lib/translations';
import type { Dictionary } from '~/i18n/types';
import type { NavLink } from '~/lib/nav';

interface Props {
  /** Where the logo links to. */
  homeHref: string;
  navItems: NavLink[];
  locale: Locale;
  alternates: Alternate[];
  dict: Dictionary;
}

const { homeHref, navItems, locale, alternates, dict } = Astro.props;
---

<header class="site-header">
  <div class="container">
    <div class="nav">
      <a class="brand" href={homeHref} aria-label="Tipza home">
        <img src="/assets/images/Tipza_Logo.svg" alt="Tipza" class="logo" loading="eager" />
      </a>

      <nav aria-label="Primary navigation" style="position: relative">
        <button class="hamburger" type="button" id="menuBtn" aria-expanded="false" aria-controls="menu">
          {dict.nav.menu}
        </button>
        <ul id="menu">
          {
            navItems.map((item) => (
              <li>
                <a class="navlink" href={item.href}>
                  {item.label}
                  <img src="/assets/images/Chevron-right.svg" alt="" class="chevron-icon" loading="lazy" />
                </a>
              </li>
            ))
          }
          <li class="mobile-store-buttons">
            <StoreButtons eager placement="header" />
          </li>
        </ul>
      </nav>

      <div class="nav-actions">
        <LanguageSwitcher locale={locale} alternates={alternates} copy={dict.languageSwitcher} />
        <div class="cta-row">
          <StoreButtons eager placement="header" />
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  /* Desktop header only: match the language selector (42px) instead of the
     56px store buttons used in the hero and download CTA. That's ~25%
     smaller. Hero, article, and mobile-menu buttons keep the full size. */
  .nav-actions :global(.store-btn) {
    box-sizing: border-box;
    height: 42px;
    padding: 0 12px;
    gap: 8px;
  }

  .nav-actions :global(.store-logo) {
    width: 16px;
    height: 16px;
  }

  .nav-actions :global(.store-text-top) {
    font-size: 9px;
  }

  .nav-actions :global(.store-text-bottom) {
    font-size: 12px;
  }

  /* On narrow screens the store buttons collapse into the menu panel, so the
     language selector sits between the logo and the menu button instead of
     being buried inside the panel. */
  @media (max-width: 1024px) {
    .nav-actions {
      order: 2;
      margin-left: auto;
    }

    .nav-actions .cta-row {
      display: none;
    }

    nav {
      order: 3;
    }
  }
</style>

<script>
  const btn = document.getElementById('menuBtn');
  const menu = document.getElementById('menu');

  const hashId = (hash: string) => decodeURIComponent(hash.replace(/^#/, ''));

  const scrollToHash = (smooth = false) => {
    const id = hashId(location.hash);
    if (!id) return;
    const el = document.getElementById(id);
    if (!el) return;
    if (smooth) {
      el.scrollIntoView({ block: 'start', behavior: 'smooth' });
      return;
    }
    const html = document.documentElement;
    html.style.scrollBehavior = 'auto';
    el.scrollIntoView({ block: 'start', behavior: 'auto' });
    html.style.scrollBehavior = '';
  };

  // Cross-page hash links (blog → /#faq) often keep the hash in the URL but
  // never move — prefetch, scroll restoration, and smooth-scroll from the top
  // of a long mobile page all cancel the native jump. Land instantly instead.
  if (location.hash) {
    history.scrollRestoration = 'manual';
    const jump = () => scrollToHash(false);
    jump();
    requestAnimationFrame(jump);
    window.addEventListener('pageshow', jump);
    window.addEventListener(
      'load',
      () => {
        jump();
        requestAnimationFrame(jump);
      },
      { once: true }
    );
  }

  window.addEventListener('hashchange', () => scrollToHash(false));

  if (btn && menu) {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = menu.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });

    const close = () => {
      menu.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
    };

    menu.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement | null)?.closest('a');
      if (!(link instanceof HTMLAnchorElement)) return;

      const url = new URL(link.href, location.href);
      const sameDocument =
        url.pathname === location.pathname && url.search === location.search;

      if (sameDocument && url.hash) {
        e.preventDefault();
        close();
        if (url.hash !== location.hash) {
          history.pushState(null, '', url.hash);
        }
        requestAnimationFrame(() => scrollToHash(false));
        return;
      }

      // Hiding the overlay in this tick (display:none) can cancel the click's
      // default navigation on mobile. Close after the browser has queued it.
      window.setTimeout(close, 0);
    });

    document.addEventListener('click', (e) => {
      if (!menu.classList.contains('open')) return;
      const target = e.target as Node;
      if (!menu.contains(target) && !btn.contains(target)) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('open')) {
        close();
        btn.focus();
      }
    });
  }

  // Clicking the logo while already on the home page scrolls up instead of
  // triggering a full navigation.
  const brand = document.querySelector<HTMLAnchorElement>('.site-header .brand');
  if (brand) {
    brand.addEventListener('click', (e) => {
      if (new URL(brand.href).pathname === window.location.pathname) {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  }
</script>
