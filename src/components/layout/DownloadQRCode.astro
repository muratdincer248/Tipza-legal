---
import { site } from '~/config/site';

interface Props {
  /** Analytics label for where this QR block appears. */
  placement: string;
  scanLabel: string;
  /** Optional extra class on the root element. */
  class?: string;
  /** Inverted colors for dark/green backgrounds. */
  inverted?: boolean;
  /** Hide the visible scan label (accessibility text stays on the block). */
  showScanLabel?: boolean;
}

const {
  placement,
  scanLabel,
  class: className = '',
  inverted = false,
  showScanLabel = true,
} = Astro.props;
const labelId = `download-qr-${placement}`;
---

<div
  class:list={['download-qr-block', className, { 'download-qr-block--inverted': inverted }]}
  data-qr-download={placement}
  aria-label={showScanLabel ? undefined : scanLabel}
  aria-labelledby={showScanLabel ? labelId : undefined}
>
  <div class="download-qr-frame">
    <img
      src="/assets/images/download-qr.svg"
      width="180"
      height="180"
      alt={`QR code to download Tipza at ${site.downloadPageUrl}`}
      class="download-qr-image"
      loading="lazy"
      decoding="async"
    />
  </div>
  {showScanLabel && <p class="download-qr-scan" id={labelId}>{scanLabel}</p>}
</div>
