---
import { site } from '~/config/site';

interface Props {
  /** Analytics label for where this QR block appears. */
  placement: string;
  headline: string;
  supporting: string;
  /** Shown below the headline on desktop. */
  scanLabel: string;
  /** Optional extra class on the root element. */
  class?: string;
  /** Inverted colors for dark/green backgrounds. */
  inverted?: boolean;
}

const {
  placement,
  headline,
  supporting,
  scanLabel,
  class: className = '',
  inverted = false,
} = Astro.props;
---

<div
  class:list={['download-qr-block', className, { 'download-qr-block--inverted': inverted }]}
  data-qr-download={placement}
  aria-labelledby={`download-qr-${placement}`}
>
  <p class="download-qr-headline" id={`download-qr-${placement}`}>{headline}</p>
  <div class="download-qr-frame">
    <img
      src="/assets/images/download-qr.svg"
      width="180"
      height="180"
      alt={`QR code to download Tipza at ${site.downloadPageUrl}`}
      class="download-qr-image"
      loading="lazy"
      decoding="async"
    />
  </div>
  <p class="download-qr-scan">{scanLabel}</p>
  <p class="download-qr-supporting">{supporting}</p>
</div>
