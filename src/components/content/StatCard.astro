---
interface Props {
  value: string;
  label: string;
  /** Where the number came from. A statistic without one is an assertion. */
  source?: string;
}

const { value, label, source } = Astro.props;
---

<div class="stat-card">
  <p class="stat-value">{value}</p>
  <p class="stat-label">{label}</p>
  {source && <p class="stat-source">{source}</p>}
</div>
