---
/** A numbered procedure. An ordered list, so the sequence is in the markup. */
interface Step {
  title: string;
  body: string;
}

interface Props {
  steps: Step[];
  label?: string;
}

const { steps, label } = Astro.props;
---

<ol class="process-steps" aria-label={label}>
  {
    steps.map((step, index) => (
      <li>
        <span class="process-step-number" aria-hidden="true">{index + 1}</span>
        <div class="process-step-text">
          <p class="process-step-title">{step.title}</p>
          <p class="process-step-body">{step.body}</p>
        </div>
      </li>
    ))
  }
</ol>
