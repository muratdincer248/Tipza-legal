---
import Figure from './Figure.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  srcMobile?: ImageMetadata;
  caption?: string;
  source?: string;
}

const { src, alt, srcMobile, caption, source } = Astro.props;
---

<Figure src={src} alt={alt} srcMobile={srcMobile} caption={caption} source={source} width="full" />
