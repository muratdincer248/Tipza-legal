---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * An image with a caption. Imported images go through `astro:assets`, which
 * emits intrinsic dimensions and a srcset, so the figure cannot cause layout
 * shift. A plain string src (an already-optimized file under /public) is
 * rendered as-is and needs explicit dimensions from the caller.
 */
export type FigureWidth = 'text' | 'wide' | 'full';

interface Props {
  src: ImageMetadata | string;
  /** Required: a decorative image belongs in CSS, not in an article. */
  alt: string;
  /** Narrow crop swapped in below 768px, when the wide one would be unreadable. */
  srcMobile?: ImageMetadata;
  caption?: string;
  /** Attribution, rendered after the caption. */
  source?: string;
  /** `text` matches the prose measure; `wide` and `full` break out of it. */
  width?: FigureWidth;
  /** Only used with a string `src`. */
  height?: number;
  imageWidth?: number;
}

const {
  src,
  alt,
  srcMobile,
  caption,
  source,
  width = 'text',
  height,
  imageWidth,
} = Astro.props;

const sizes =
  width === 'full'
    ? '100vw'
    : width === 'wide'
      ? '(max-width: 1000px) 100vw, 960px'
      : '(max-width: 860px) 100vw, 780px';

const candidates = [480, 780, 960, 1440, 1920];
const widthsFor = (image: ImageMetadata) => [
  ...candidates.filter((candidate) => candidate < image.width),
  image.width,
];
---

<figure class={`article-figure article-figure-${width}`}>
  {
    typeof src === 'string' ? (
      <img src={src} alt={alt} width={imageWidth} height={height} loading="lazy" decoding="async" />
    ) : srcMobile ? (
      <picture>
        <source
          media="(max-width: 767px)"
          srcset={srcMobile.src}
          width={srcMobile.width}
          height={srcMobile.height}
        />
        <Image src={src} alt={alt} widths={widthsFor(src)} sizes={sizes} loading="lazy" />
      </picture>
    ) : (
      <Image src={src} alt={alt} widths={widthsFor(src)} sizes={sizes} loading="lazy" />
    )
  }

  {
    (caption || source) && (
      <figcaption>
        {caption}
        {source && <span class="figure-source">{source}</span>}
      </figcaption>
    )
  }
</figure>
