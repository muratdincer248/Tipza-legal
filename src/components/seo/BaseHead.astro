---
import { site } from '~/config/site';
import { localeMeta, localePath, type Locale } from '~/config/locales';
import { hreflangAlternates, xDefaultAlternate, type Alternate } from '~/lib/translations';
import { defaultOgImage, type OgImage } from '~/lib/ogImage';
import { serializeSchema, type Node } from '~/lib/schema';

export interface Props {
  title: string;
  description?: string;
  locale: Locale;
  /** Locale-relative path of this page, e.g. '' or 'blog/how-to-split-tips/'. */
  path: string;
  alternates: Alternate[];
  ogType?: 'website' | 'article';
  ogImage?: OgImage;
  ogDescription?: string;
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  /** One `@graph` for the page, built by `lib/schema.ts`. */
  jsonLd?: Node;
}

const {
  title,
  description,
  locale,
  path,
  alternates,
  ogType = 'website',
  ogImage = defaultOgImage,
  ogDescription,
  noindex = false,
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props;

const canonical = new URL(localePath(locale, path), site.url).href;
const ogImageUrl = new URL(ogImage.url, site.url).href;
const translated = hreflangAlternates(alternates);
const xDefault = xDefaultAlternate(alternates);
const meta = localeMeta[locale];
---

<title>{title}</title>
{description && <meta name="description" content={description} />}
{noindex && <meta name="robots" content="noindex, follow" />}

{/* A page asking not to be indexed has no business naming a canonical or
    advertising translations: both are instructions about how to index it, and
    stating them alongside `noindex` is a contradiction a crawler has to guess at. */}
{
  !noindex && (
    <Fragment>
      <link rel="canonical" href={canonical} />
      {translated.map((alternate) => (
        <link
          rel="alternate"
          hreflang={localeMeta[alternate.locale].hreflang}
          href={new URL(alternate.href, site.url).href}
        />
      ))}
      {xDefault && (
        <link rel="alternate" hreflang="x-default" href={new URL(xDefault.href, site.url).href} />
      )}
    </Fragment>
  )
}

<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={ogDescription ?? description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content={String(ogImage.width)} />
<meta property="og:image:height" content={String(ogImage.height)} />
{ogImage.alt && <meta property="og:image:alt" content={ogImage.alt} />}
<meta property="og:locale" content={meta.ogLocale} />
{
  translated
    .filter((alternate) => alternate.locale !== locale)
    .map((alternate) => (
      <meta property="og:locale:alternate" content={localeMeta[alternate.locale].ogLocale} />
    ))
}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={ogDescription ?? description} />
<meta name="twitter:image" content={ogImageUrl} />
{ogImage.alt && <meta name="twitter:image:alt" content={ogImage.alt} />}

{jsonLd && <script type="application/ld+json" is:inline set:html={serializeSchema(jsonLd)} />}
