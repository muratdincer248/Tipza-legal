---
import type { Dictionary } from '~/i18n/types';

interface Props {
  copy: Dictionary['benefits'];
}

const { copy } = Astro.props;
---

<section class="section" id="benefits">
  <div class="container">
    <h2>{copy.heading}</h2>
    <p>{copy.lead}</p>

    <div class="grid-3" role="list" aria-label={copy.listLabel}>
      {
        copy.items.map((item) => (
          <div class="purpose-item" role="listitem">
            <img src={item.image} alt={item.imageAlt} class="benefit-image" loading="lazy" />
            <h3>{item.heading}</h3>
            <p>{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
