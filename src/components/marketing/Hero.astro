---
import AppDownloadCTA from '../layout/AppDownloadCTA.astro';
import type { Dictionary } from '~/i18n/types';

interface Props {
  copy: Dictionary['hero'];
  appDownload: Dictionary['appDownload'];
}

const { copy, appDownload } = Astro.props;
---

<section class="hero" id="top">
  <div class="container">
    <div class="hero-grid">
      <div>
        <h1>{copy.heading}</h1>

        <p class="lead">{copy.lead}</p>

        <div class="bullets" id="download">
          <AppDownloadCTA copy={appDownload} placement="hero" eager />
        </div>
      </div>

      <img
        src="/assets/images/website-hero-image.png"
        alt={copy.imageAlt}
        class="hero-image"
        loading="eager"
      />
    </div>
  </div>
</section>
