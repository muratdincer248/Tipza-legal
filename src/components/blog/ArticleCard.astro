---
import { Image } from 'astro:assets';
import CategoryPill from './CategoryPill.astro';
import type { Article } from '~/lib/blog';
import type { Locale } from '~/config/locales';
import type { Dictionary } from '~/i18n/types';
import { formatDate, isoDate } from '~/lib/formatDate';
import { coverWidths } from '~/lib/images';

interface Props {
  article: Article;
  locale: Locale;
  dict: Dictionary;
  /** Set to keep the document outline correct wherever the card is placed. */
  headingLevel?: 'h2' | 'h3';
}

const { article, locale, dict, headingLevel = 'h3' } = Astro.props;
const { data } = article.entry;
const Heading = headingLevel;
---

<a class="card-link article-card" href={article.href}>
  <Image
    class="article-card-cover"
    src={data.coverImage}
    alt={data.coverImageAlt}
    widths={coverWidths(data.coverImage, [360, 720, 1080])}
    sizes="(max-width: 920px) 100vw, 360px"
    loading="lazy"
  />
  <div class="card article-card-body">
    <CategoryPill category={article.category} locale={locale} link={false} />
    <Heading>{data.title}</Heading>
    <p>{data.excerpt}</p>
    <p class="article-card-meta">
      <time datetime={isoDate(article.publishedAt)}>{formatDate(article.publishedAt, locale)}</time>
      <span aria-hidden="true">·</span>
      <span>{article.readingTime} {dict.blog.minRead}</span>
    </p>
  </div>
</a>
