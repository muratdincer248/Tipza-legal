---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '~/config/locales';
import type { Dictionary } from '~/i18n/types';
import { formatDate, isoDate } from '~/lib/formatDate';

interface Props {
  author: CollectionEntry<'authors'>;
  locale: Locale;
  dict: Dictionary;
  publishedAt: Date;
  updatedAt?: Date;
  readingTime: number;
}

const { author, locale, dict, publishedAt, updatedAt, readingTime } = Astro.props;
const { name, role, avatar } = author.data;

const initials = name
  .split(/\s+/)
  .slice(0, 2)
  .map((word) => word[0]?.toUpperCase() ?? '')
  .join('');
---

<div class="article-byline">
  {
    avatar ? (
      <span class="article-byline-avatar">
        <Image src={avatar} alt="" width={88} height={88} />
      </span>
    ) : (
      <span class="article-byline-avatar article-byline-monogram" aria-hidden="true">
        {initials}
      </span>
    )
  }

  <div class="article-byline-text">
    <p class="article-byline-name">
      {dict.blog.byPrefix} <strong>{name}</strong>
      <span class="article-byline-role">{role[locale]}</span>
    </p>
    <p class="article-byline-meta">
      <time datetime={isoDate(publishedAt)}>
        {dict.blog.publishedPrefix} {formatDate(publishedAt, locale)}
      </time>
      {
        updatedAt && (
          <>
            <span aria-hidden="true">·</span>
            <time datetime={isoDate(updatedAt)}>
              {dict.blog.updatedPrefix} {formatDate(updatedAt, locale)}
            </time>
          </>
        )
      }
      <span aria-hidden="true">·</span>
      <span>{readingTime} {dict.blog.minRead}</span>
    </p>
  </div>
</div>
