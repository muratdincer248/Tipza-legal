---
import { Image } from 'astro:assets';
import CategoryPill from './CategoryPill.astro';
import type { Article } from '~/lib/blog';
import type { Locale } from '~/config/locales';
import type { Dictionary } from '~/i18n/types';
import { formatDate, isoDate } from '~/lib/formatDate';
import { coverWidths } from '~/lib/images';

interface Props {
  article: Article;
  locale: Locale;
  dict: Dictionary;
}

const { article, locale, dict } = Astro.props;
const { data } = article.entry;
---

<a class="card-link featured-article" href={article.href}>
  <Image
    class="featured-article-cover"
    src={data.coverImage}
    alt={data.coverImageAlt}
    widths={coverWidths(data.coverImage, [640, 1000, 1600])}
    sizes="(max-width: 920px) 100vw, 620px"
    loading="eager"
  />
  <div class="card featured-article-body">
    <p class="eyebrow">{dict.blog.featuredLabel}</p>
    <CategoryPill category={article.category} locale={locale} link={false} />
    <h2>{data.title}</h2>
    <p class="featured-article-excerpt">{data.excerpt}</p>
    <p class="article-card-meta">
      <time datetime={isoDate(article.publishedAt)}>{formatDate(article.publishedAt, locale)}</time>
      <span aria-hidden="true">·</span>
      <span>{article.readingTime} {dict.blog.minRead}</span>
    </p>
  </div>
</a>
