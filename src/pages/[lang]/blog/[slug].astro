---
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';
import ArticleLayout from '~/layouts/ArticleLayout.astro';
import H2 from '~/components/content/H2.astro';
import H3 from '~/components/content/H3.astro';
import DataTable from '~/components/content/DataTable.astro';
import Quote from '~/components/content/Quote.astro';
import SmartLink from '~/components/content/SmartLink.astro';
import { allArticles, articleAlternates, relatedArticles, type Article } from '~/lib/blog';
import type { Alternate } from '~/lib/translations';

export const getStaticPaths: GetStaticPaths = async () => {
  const all = await allArticles();

  return all.map((article) => ({
    params: { lang: article.locale, slug: article.slug },
    props: {
      article,
      alternates: articleAlternates(all, article.translationKey),
      related: relatedArticles(article, all),
    },
  }));
};

interface Props {
  article: Article;
  alternates: Alternate[];
  related: Article[];
}

const { article, alternates, related } = Astro.props as Props;

const author = await getEntry(article.entry.data.author);
if (!author) {
  throw new Error(
    `Article "${article.entry.id}" references unknown author "${article.entry.data.author.id}".`
  );
}

const { Content, headings } = await render(article.entry);

/**
 * Ordinary Markdown gets the styled components without the author importing
 * anything, which is what keeps a plain article a plain file. Only the genuinely
 * special blocks — callouts, comparison tables, charts — are imported in the MDX.
 */
const components = {
  h2: H2,
  h3: H3,
  table: DataTable,
  blockquote: Quote,
  a: SmartLink,
};
---

<ArticleLayout
  article={article}
  author={author}
  locale={article.locale}
  alternates={alternates}
  headings={headings}
  related={related}
>
  <Content components={components} />
</ArticleLayout>
