---
import MarketingLayout from '~/layouts/MarketingLayout.astro';
import Hero from '~/components/marketing/Hero.astro';
import PurposeSection from '~/components/marketing/PurposeSection.astro';
import HowItWorks from '~/components/marketing/HowItWorks.astro';
import Benefits from '~/components/marketing/Benefits.astro';
import ProSection from '~/components/marketing/ProSection.astro';
import FaqSection from '~/components/marketing/FaqSection.astro';
import DownloadCta from '~/components/marketing/DownloadCta.astro';
import ContactSection from '~/components/marketing/ContactSection.astro';
import { LOCALES, localeBase, type Locale } from '~/config/locales';
import { getDictionary } from '~/i18n';
import { symmetricAlternates } from '~/lib/translations';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const dict = getDictionary(locale);
const base = localeBase(locale);
---

<MarketingLayout
  locale={locale}
  path=""
  alternates={symmetricAlternates('')}
  title={dict.meta.homeTitle}
  description={dict.meta.homeDescription}
  ogDescription={dict.meta.homeOgDescription}
  preloadImages={['/assets/images/website-hero-image.png']}
>
  <Hero copy={dict.hero} />
  <PurposeSection copy={dict.purpose} />
  <HowItWorks copy={dict.how} />
  <Benefits copy={dict.benefits} />
  <ProSection copy={dict.pro} />
  <FaqSection copy={dict.faq} />
  <DownloadCta copy={dict.downloadCta} />
  <ContactSection
    copy={dict.contact}
    privacyHref={`${base}privacy/`}
    termsHref={`${base}terms/`}
    accountDeletionHref={`${base}account-deletion/`}
  />
</MarketingLayout>
